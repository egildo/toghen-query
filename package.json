{
  "name": "@toghen/query",
  "version": "0.1.0",
  "description": "A command line that asks the core of Toghen its questions and prints the answers",
  "type": "module",
  "bin": {
    "toghen-query": "dist/main.js"
  },
  "scripts": {
    "test": "node --import tsx/esm --test 'test/**/*.test.ts'",
    "build": "tsup src/main.ts --format esm --clean --external @toghen/lib",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "query": "tsx src/main.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "biome check . && pnpm typecheck && pnpm test && pnpm build && node scripts/check-purity.mjs"
  },
  "keywords": [
    "design-tokens",
    "w3c",
    "query"
  ],
  "author": "Egildo Tagliareni <egildo@tagliareni.it>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://codeberg.org/Toghen/query.git"
  },
  "files": [
    "dist/",
    "sessions/"
  ],
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@toghen/lib": "^0.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.1.0",
    "tsup": "^8.4.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.29.3"
}
